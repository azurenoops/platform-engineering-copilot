# Platform Engineering Copilot - API Configuration
# Copy this file to .env and update values

# MCP Server URL (HTTP mode)
PLATFORM_COPILOT_API_URL=http://localhost:5100

# Optional API Key for authentication
PLATFORM_COPILOT_API_KEY=

# Request timeout in milliseconds (default: 60000)
PLATFORM_COPILOT_TIMEOUT=60000
