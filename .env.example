# Platform Engineering Copilot — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# Azure Subscription
# =============================================================================
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_REGION=usgovvirginia

# =============================================================================
# Azure OpenAI
# =============================================================================
AZURE_OPENAI_ENDPOINT=<your-azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# =============================================================================
# Database (Azure SQL Edge for dev, Azure SQL for prod)
# =============================================================================
DB_SA_PASSWORD=DevPassword123!
DB_CONNECTION_STRING=Server=localhost;Database=PlatformCopilot;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true

# =============================================================================
# Authentication (Azure AD / Entra ID)
# =============================================================================
AUTH_TENANT_ID=<your-tenant-id>
AUTH_CLIENT_ID=<your-client-id>
AUTH_AUTHORITY=https://login.microsoftonline.us

# =============================================================================
# Application Insights (optional — prod only)
# =============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=

# =============================================================================
# Key Vault (optional — prod only)
# =============================================================================
AZURE_KEY_VAULT_URI=
