    private async Task ParseBicepParameters()
    {
        _isParsing = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_model.TemplateContent))
            {
                ToastService.ShowWarning("Template content is empty");
                return;
            }

            var response = await Http.PostAsJsonAsync("api/templates/parse-bicep-parameters", new
            {
                BicepContent = _model.TemplateContent
            });

            if (response.IsSuccessStatusCode)
            {
                var parameters = await response.Content.ReadFromJsonAsync<List<TemplateParameterDto>>();
                if (parameters?.Any() == true)
                {
                    // Convert DTOs to CreateParameterModel and add to list
                    var newParams = parameters.Select(p => new CreateParameterModel
                    {
                        Name = p.Name,
                        DisplayName = p.DisplayName,
                        Description = p.Description,
                        Type = p.Type,
                        Required = p.Required,
                        DefaultValue = p.DefaultValue,
                        AllowedValues = p.AllowedValues?.Select(v => v?.ToString() ?? "").ToList() ?? new List<string>(),
                        MinValue = p.MinValue,
                        MaxValue = p.MaxValue
                    }).ToList();

                    // Replace existing parameters or ask user
                    if (_parameters.Any())
                    {
                        // For now, just add unique parameters
                        var existingNames = _parameters.Select(p => p.Name).ToHashSet();
                        var uniqueParams = newParams.Where(p => !existingNames.Contains(p.Name)).ToList();
                        _parameters.AddRange(uniqueParams);
                        ToastService.ShowSuccess($"Added {uniqueParams.Count} new parameters (skipped {newParams.Count - uniqueParams.Count} duplicates)");
                    }
                    else
                    {
                        _parameters.AddRange(newParams);
                        ToastService.ShowSuccess($"Parsed {newParams.Count} parameters from Bicep template");
                    }
                }
                else
                {
                    ToastService.ShowWarning("No parameters found in Bicep template");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to parse parameters: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isParsing = false;
        }
    }

    private async Task ParseBicepParametersFromGit()
    {
        _isParsing = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_gitRepositoryUrl) || string.IsNullOrWhiteSpace(_gitPath))
            {
                ToastService.ShowWarning("Please provide both repository URL and file path");
                return;
            }

            var response = await Http.PostAsJsonAsync("api/templates/parse-bicep-parameters-from-git", new
            {
                RepositoryUrl = _gitRepositoryUrl,
                Branch = _gitBranch,
                Path = _gitPath
            });

            if (response.IsSuccessStatusCode)
            {
                var parsedParams = await response.Content.ReadFromJsonAsync<List<TemplateParameterDto>>();
                if (parsedParams != null && parsedParams.Any())
                {
                    var newParams = parsedParams.Select(p => new CreateParameterModel
                    {
                        Name = p.Name ?? "",
                        DisplayName = p.DisplayName,
                        Description = p.Description,
                        Type = p.Type ?? "String",
                        Required = p.Required,
                        DefaultValue = p.DefaultValue,
                        AllowedValues = p.AllowedValues?.Select(v => v.ToString() ?? "").ToList() ?? new List<string>(),
                        MinValue = p.MinValue,
                        MaxValue = p.MaxValue
                    }).ToList();

                    // Add unique parameters
                    if (_parameters.Any())
                    {
                        var existingNames = _parameters.Select(p => p.Name).ToHashSet();
                        var uniqueParams = newParams.Where(p => !existingNames.Contains(p.Name)).ToList();
                        _parameters.AddRange(uniqueParams);
                        ToastService.ShowSuccess($"Added {uniqueParams.Count} new parameters from Git (skipped {newParams.Count - uniqueParams.Count} duplicates)");
                    }
                    else
                    {
                        _parameters.AddRange(newParams);
                        ToastService.ShowSuccess($"Parsed {newParams.Count} parameters from Git repository");
                    }
                }
                else
                {
                    ToastService.ShowWarning("No parameters found in Git Bicep template");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to parse parameters from Git: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error parsing Bicep parameters: {ex.Message}");
        }
        finally
        {
            _isParsing = false;
        }
    }
