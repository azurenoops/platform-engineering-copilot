@page "/deployments"
@inject HttpClient Http

<PageTitle>Deployments</PageTitle>

<div class="page-content" role="main" aria-label="Deployment Tracking">
    <div class="page-header">
        <h1>Deployments</h1>
        <button class="btn-primary" @onclick="ShowDeployForm" aria-label="Create new deployment">
            + New Deployment
        </button>
    </div>

    @if (showForm)
    {
        <div class="form-panel" role="form" aria-label="Create Deployment">
            <h2>New Deployment</h2>
            <div class="form-group">
                <label for="dep-template">Template ID <span class="required" aria-label="required">*</span></label>
                <input id="dep-template" @bind="formTemplateId" required aria-required="true" />
            </div>
            <div class="form-group">
                <label for="dep-env">Environment ID <span class="required" aria-label="required">*</span></label>
                <input id="dep-env" @bind="formEnvironmentId" required aria-required="true" />
            </div>
            <div class="form-actions">
                <button class="btn-primary" @onclick="CreateDeployment">Deploy</button>
                <button class="btn-secondary" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    <div class="filter-bar" role="search" aria-label="Filter deployments">
        <label for="filter-env">Environment:</label>
        <input id="filter-env" @bind="filterEnvironment" @bind:event="oninput" placeholder="All" />
        <label for="filter-status">Status:</label>
        <select id="filter-status" @bind="filterStatus" aria-label="Filter by status">
            <option value="">All</option>
            <option value="Succeeded">Succeeded</option>
            <option value="Failed">Failed</option>
            <option value="InProgress">In Progress</option>
        </select>
        <button class="btn-sm" @onclick="LoadDeployments" aria-label="Apply filters">Filter</button>
    </div>

    @if (deployments is null)
    {
        <p role="status" aria-live="polite">Loading deployments...</p>
    }
    else if (deployments.Length == 0)
    {
        <p role="status">No deployments found.</p>
    }
    else
    {
        <table class="data-table" role="table" aria-label="Deployment history">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Template</th>
                    <th scope="col">Environment</th>
                    <th scope="col">Status</th>
                    <th scope="col">Initiated By</th>
                    <th scope="col">Started</th>
                    <th scope="col">Completed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dep in deployments)
                {
                    <tr>
                        <td><code>@dep.DeploymentId</code></td>
                        <td>@dep.TemplateName</td>
                        <td>@dep.EnvironmentName</td>
                        <td>
                            <span class="badge @GetStatusBadge(dep.Status)" aria-label="Status: @dep.Status">
                                @dep.Status
                            </span>
                        </td>
                        <td>@dep.InitiatedBy</td>
                        <td>@dep.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(dep.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private DeploymentDto[]? deployments;
    private bool showForm;
    private string formTemplateId = "";
    private string formEnvironmentId = "";
    private string filterEnvironment = "";
    private string filterStatus = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDeployments();
    }

    private async Task LoadDeployments()
    {
        try
        {
            var query = "api/deployments";
            var queryParams = new List<string>();
            if (!string.IsNullOrWhiteSpace(filterEnvironment)) queryParams.Add($"environment={filterEnvironment}");
            if (!string.IsNullOrWhiteSpace(filterStatus)) queryParams.Add($"status={filterStatus}");
            if (queryParams.Count > 0) query += "?" + string.Join("&", queryParams);

            var result = await Http.GetFromJsonAsync<DeploymentListResponse>(query);
            deployments = result?.Deployments ?? Array.Empty<DeploymentDto>();
        }
        catch
        {
            deployments = Array.Empty<DeploymentDto>();
        }
    }

    private void ShowDeployForm() => showForm = true;
    private void CancelForm() => showForm = false;

    private async Task CreateDeployment()
    {
        var payload = new { templateId = formTemplateId, environmentId = formEnvironmentId };
        await Http.PostAsJsonAsync("api/deployments", payload);
        showForm = false;
        await LoadDeployments();
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Succeeded" => "badge-success",
        "Failed" => "badge-danger",
        "InProgress" => "badge-warning",
        _ => "badge-info"
    };

    private record DeploymentListResponse(DeploymentDto[] Deployments, int TotalCount);
    private record DeploymentDto(string DeploymentId, string TemplateName, string EnvironmentName, string Status, string InitiatedBy, DateTimeOffset StartedAt, DateTimeOffset? CompletedAt);
}
