@page "/templates"
@inject TemplateApiService TemplateApi
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Service Templates — Platform Engineering Admin</PageTitle>

@if (_loading)
{
    <LoadingSpinner Text="Loading templates..." />
}
else if (_loadError)
{
    <EmptyState Icon="fas fa-exclamation-triangle fa-3x text-danger"
                Title="Failed to Load Templates"
                Message="Unable to retrieve templates from the Admin API."
                OnRetry="LoadDataAsync" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <input type="text" class="form-control" placeholder="Search templates..."
                   @bind="_searchQuery" @bind:event="oninput" @onkeyup="OnSearchChanged"
                   style="width: 250px;" />
            <select class="form-select" @bind="_selectedCategory" @bind:after="ApplyFilters" style="width: 180px;">
                <option value="">All Categories</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
            <select class="form-select" @bind="_selectedStatus" @bind:after="ApplyFilters" style="width: 160px;">
                <option value="">All Statuses</option>
                <option value="Draft">Draft</option>
                <option value="PendingApproval">Pending Approval</option>
                <option value="Published">Published</option>
                <option value="Deprecated">Deprecated</option>
                <option value="Archived">Archived</option>
            </select>
        </div>
        <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/templates/create")'>
            <i class="fas fa-plus me-1"></i> Create Template
        </button>
    </div>

    @if (_filteredTemplates.Any())
    {
        <div class="card-grid">
            @foreach (var template in _pagedTemplates)
            {
                <div class="card h-100 cursor-pointer" @onclick="() => ViewTemplate(template.TemplateId)">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0">@(template.DisplayName ?? template.Name)</h6>
                            <StatusBadge Status="@template.Status" />
                        </div>
                        @if (!string.IsNullOrEmpty(template.Description))
                        {
                            <p class="card-text text-muted small mb-2">
                                @(template.Description.Length > 120 ? template.Description[..120] + "..." : template.Description)
                            </p>
                        }
                        <div class="d-flex gap-2 flex-wrap">
                            @if (!string.IsNullOrEmpty(template.Category))
                            {
                                <span class="badge bg-info">@template.Category</span>
                            }
                            @if (!string.IsNullOrEmpty(template.Version))
                            {
                                <span class="badge bg-secondary">v@(template.Version)</span>
                            }
                            @if (!string.IsNullOrEmpty(template.Format))
                            {
                                <span class="badge bg-outline-secondary">@template.Format</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer text-muted small">
                        <i class="fas fa-clock me-1"></i> @template.CreatedAt.ToString("MMM dd, yyyy")
                        @if (template.HasGitSource)
                        {
                            <span class="ms-2"><i class="fab fa-git-alt me-1"></i> Git</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
            <Pagination CurrentPage="_currentPage" PageSize="_pageSize"
                        TotalItems="_filteredTemplates.Count" PageChanged="OnPageChanged" />
        </div>
    }
    else
    {
        <EmptyState Icon="fas fa-file-code fa-3x text-muted"
                    Title="No Templates Found"
                    Message="@(_allTemplates.Any() ? "Try adjusting your search or filters." : "Get started by creating your first template.")"
                    ActionText="Create Template"
                    OnAction='() => NavigationManager.NavigateTo("/templates/create")' />
    }
}

@code {
    private bool _loading = true;
    private bool _loadError;
    private List<TemplateSummaryDto> _allTemplates = new();
    private List<TemplateSummaryDto> _filteredTemplates = new();
    private List<string> _categories = new();
    private string _searchQuery = string.Empty;
    private string _selectedCategory = string.Empty;
    private string _selectedStatus = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 12;

    private IEnumerable<TemplateSummaryDto> _pagedTemplates =>
        _filteredTemplates.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _loadError = false;
        StateHasChanged();

        try
        {
            var templatesTask = TemplateApi.GetTemplatesAsync();
            var categoriesTask = TemplateApi.GetCategoriesAsync();

            await Task.WhenAll(templatesTask, categoriesTask);

            _allTemplates = await templatesTask ?? new();
            _categories = await categoriesTask ?? new();

            ApplyFilters();
        }
        catch
        {
            _loadError = true;
            ToastService.ShowError("Failed to load templates.");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        _filteredTemplates = _allTemplates.Where(t =>
        {
            if (!string.IsNullOrEmpty(_searchQuery))
            {
                var q = _searchQuery.ToLowerInvariant();
                if (!(t.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                      (t.DisplayName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                      (t.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)))
                    return false;
            }
            if (!string.IsNullOrEmpty(_selectedCategory) && t.Category != _selectedCategory)
                return false;
            if (!string.IsNullOrEmpty(_selectedStatus) && t.Status != _selectedStatus)
                return false;
            return true;
        }).ToList();

        _currentPage = 1;
        StateHasChanged();
    }

    private void OnSearchChanged()
    {
        ApplyFilters();
    }

    private void OnPageChanged(int page)
    {
        _currentPage = page;
        StateHasChanged();
    }

    private void ViewTemplate(Guid id)
    {
        NavigationManager.NavigateTo($"/templates/{id}");
    }
}
