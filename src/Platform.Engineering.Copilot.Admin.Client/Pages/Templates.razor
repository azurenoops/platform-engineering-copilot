@page "/templates"
@inject HttpClient Http

<PageTitle>Service Templates</PageTitle>

<div class="page-content" role="main" aria-label="Service Template Management">
    <div class="page-header">
        <h1>Service Templates</h1>
        <button class="btn-primary" @onclick="ShowCreateForm" aria-label="Create new service template">
            + New Template
        </button>
    </div>

    @if (showForm)
    {
        <div class="form-panel" role="form" aria-label="@(editingTemplate is not null ? "Edit Template" : "Create Template")">
            <h2>@(editingTemplate is not null ? "Edit Template" : "New Template")</h2>
            <div class="form-group">
                <label for="tmpl-name">Name <span class="required" aria-label="required">*</span></label>
                <input id="tmpl-name" @bind="formName" required aria-required="true" />
            </div>
            <div class="form-group">
                <label for="tmpl-desc">Description</label>
                <textarea id="tmpl-desc" @bind="formDescription" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label for="tmpl-cat">Category</label>
                <select id="tmpl-cat" @bind="formCategory" aria-label="Template category">
                    <option value="Compute">Compute</option>
                    <option value="Storage">Storage</option>
                    <option value="Networking">Networking</option>
                    <option value="Security">Security</option>
                    <option value="Database">Database</option>
                </select>
            </div>
            <div class="form-group">
                <label for="tmpl-ver">Version</label>
                <input id="tmpl-ver" @bind="formVersion" placeholder="1.0.0" />
            </div>
            <div class="form-actions">
                <button class="btn-primary" @onclick="SaveTemplate">Save</button>
                <button class="btn-secondary" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    @if (templates is null)
    {
        <p role="status" aria-live="polite">Loading templates...</p>
    }
    else if (templates.Length == 0)
    {
        <p role="status">No templates found. Create one to get started.</p>
    }
    else
    {
        <table class="data-table" role="table" aria-label="Service templates list">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Category</th>
                    <th scope="col">Version</th>
                    <th scope="col">Status</th>
                    <th scope="col">Git Sync</th>
                    <th scope="col">Updated</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tmpl in templates)
                {
                    <tr>
                        <td>@tmpl.Name</td>
                        <td>@tmpl.Category</td>
                        <td>@tmpl.Version</td>
                        <td>
                            <span class="badge @(tmpl.IsApproved ? "badge-success" : "badge-warning")"
                                  aria-label="@(tmpl.IsApproved ? "Approved" : "Pending")">
                                @(tmpl.IsApproved ? "Approved" : "Pending")
                            </span>
                        </td>
                        <td>@tmpl.GitSyncStatus</td>
                        <td>@tmpl.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="actions">
                            <button class="btn-sm" @onclick="() => EditTemplate(tmpl)" aria-label="Edit @tmpl.Name">Edit</button>
                            <button class="btn-sm btn-danger" @onclick="() => DeleteTemplate(tmpl.TemplateId)" aria-label="Delete @tmpl.Name">Delete</button>
                            <button class="btn-sm" @onclick="() => SyncTemplate(tmpl.TemplateId)" aria-label="Sync @tmpl.Name">Sync</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private TemplateDto[]? templates;
    private bool showForm;
    private TemplateDto? editingTemplate;

    private string formName = "";
    private string formDescription = "";
    private string formCategory = "Compute";
    private string formVersion = "1.0.0";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<TemplateListResponse>("api/templates");
            templates = result?.Templates ?? Array.Empty<TemplateDto>();
        }
        catch
        {
            templates = Array.Empty<TemplateDto>();
        }
    }

    private void ShowCreateForm()
    {
        editingTemplate = null;
        formName = "";
        formDescription = "";
        formCategory = "Compute";
        formVersion = "1.0.0";
        showForm = true;
    }

    private void EditTemplate(TemplateDto tmpl)
    {
        editingTemplate = tmpl;
        formName = tmpl.Name;
        formDescription = tmpl.Description;
        formCategory = tmpl.Category;
        formVersion = tmpl.Version;
        showForm = true;
    }

    private void CancelForm() => showForm = false;

    private async Task SaveTemplate()
    {
        var payload = new { name = formName, description = formDescription, category = formCategory, version = formVersion };
        if (editingTemplate is not null)
            await Http.PutAsJsonAsync($"api/templates/{editingTemplate.TemplateId}", payload);
        else
            await Http.PostAsJsonAsync("api/templates", payload);
        showForm = false;
        await LoadTemplates();
    }

    private async Task DeleteTemplate(string templateId)
    {
        await Http.DeleteAsync($"api/templates/{templateId}");
        await LoadTemplates();
    }

    private async Task SyncTemplate(string templateId)
    {
        await Http.PostAsync($"api/templates/{templateId}/sync", null);
        await LoadTemplates();
    }

    private record TemplateListResponse(TemplateDto[] Templates, int TotalCount);
    private record TemplateDto(string TemplateId, string Name, string Description, string Category, string Version, bool IsApproved, string? ApprovedBy, string GitSyncStatus, DateTimeOffset UpdatedAt);
}
