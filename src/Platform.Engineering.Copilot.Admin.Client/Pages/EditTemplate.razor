    private async Task ParseBicepParameters()
    {
        _isParsing = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_model.TemplateContent))
            {
                ToastService.ShowWarning("Template content is empty");
                return;
            }

            var response = await Http.PostAsJsonAsync("api/templates/parse-bicep-parameters", new
            {
                BicepContent = _model.TemplateContent
            });

            if (response.IsSuccessStatusCode)
            {
                var parsedParams = await response.Content.ReadFromJsonAsync<List<TemplateParameterDto>>();
                if (parsedParams?.Any() == true)
                {
                    // Convert DTOs to CreateParameterModel
                    var newParams = parsedParams.Select(p => new CreateParameterModel
                    {
                        Name = p.Name,
                        DisplayName = p.DisplayName,
                        Description = p.Description,
                        Type = p.Type,
                        Required = p.Required,
                        DefaultValue = p.DefaultValue,
                        AllowedValues = p.AllowedValues?.Select(v => v?.ToString() ?? "").ToList() ?? new List<string>(),
                        MinValue = p.MinValue,
                        MaxValue = p.MaxValue
                    }).ToList();

                    // Merge with existing parameters
                    var existingByName = _parameters.ToDictionary(p => p.Name, p => p);
                    int added = 0, updated = 0, unchanged = 0;

                    foreach (var newParam in newParams)
                    {
                        if (existingByName.TryGetValue(newParam.Name, out var existing))
                        {
                            // Parameter exists - check if it needs updating
                            if (existing.Type != newParam.Type ||
                                existing.Description != newParam.Description ||
                                existing.Required != newParam.Required ||
                                existing.DefaultValue != newParam.DefaultValue)
                            {
                                // Update existing parameter
                                existing.Type = newParam.Type;
                                existing.Description = newParam.Description;
                                existing.Required = newParam.Required;
                                existing.DefaultValue = newParam.DefaultValue;
                                existing.AllowedValues = newParam.AllowedValues;
                                existing.MinValue = newParam.MinValue;
                                existing.MaxValue = newParam.MaxValue;
                                updated++;
                            }
                            else
                            {
                                unchanged++;
                            }
                        }
                        else
                        {
                            // New parameter - add it
                            _parameters.Add(newParam);
                            added++;
                        }
                    }

                    // Show summary
                    var message = $"Parsed {parsedParams.Count} parameters: {added} added, {updated} updated, {unchanged} unchanged";
                    ToastService.ShowSuccess(message);
                }
                else
                {
                    ToastService.ShowWarning("No parameters found in Bicep template");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Failed to parse parameters: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error parsing Bicep parameters: {ex.Message}");
        }
        finally
        {
            _isParsing = false;
        }
    }

    private async Task ValidateTemplate()
    {
        _validating = true;
        _validationResult = null;
        
        try
        {
            _validationResult = await TemplateApi.ValidateTemplateAsync(new ValidateTemplateModel
            {
                Name = _template?.Name ?? "",
                TemplateContent = _model.TemplateContent,
                Format = _template?.Format ?? "Bicep"
            });

            if (_validationResult.IsValid)
            {
                ToastService.ShowSuccess("Template validation passed");
            }
            else
            {
                ToastService.ShowError($"Validation failed with {_validationResult.Errors.Count} errors");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Validation error: {ex.Message}");
        }
        finally
        {
            _validating = false;
        }
    }

    private string GetStatusColor(string status) => status switch
    {
        "Published" => "success",
        "Draft" => "secondary",
        "PendingApproval" => "warning",
        "Deprecated" => "danger",
        _ => "secondary"
    };
