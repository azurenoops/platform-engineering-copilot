@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <div class="sidebar-header">
            <h4><i class="fa fa-cogs me-2"></i>Platform Admin</h4>
            <small>Environment Management</small>
        </div>
        
        <nav class="nav-section">
            <div class="nav-section-title">Dashboard</div>
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="fa fa-home"></i>
                <span>Overview</span>
            </NavLink>
        </nav>
        
        <nav class="nav-section">
            <div class="nav-section-title">Service Templates</div>
            <NavLink class="nav-link" href="templates">
                <i class="fa fa-cube"></i>
                <span>Template Catalog</span>
            </NavLink>
            <NavLink class="nav-link" href="templates/create">
                <i class="fa fa-plus-circle"></i>
                <span>Create Service Template</span>
            </NavLink>
        </nav>
        
        <nav class="nav-section">
            <div class="nav-section-title">Environments</div>
            <NavLink class="nav-link" href="environments">
                <i class="fa fa-server"></i>
                <span>All Environments</span>
            </NavLink>
            <NavLink class="nav-link" href="environments/create">
                <i class="fa fa-rocket"></i>
                <span>Provision New</span>
            </NavLink>
            <NavLink class="nav-link" href="environments/expiring">
                <i class="fa fa-clock"></i>
                <span>Expiring Soon</span>
            </NavLink>
        </nav>
        
        <nav class="nav-section">
            <div class="nav-section-title">Compliance</div>
            <NavLink class="nav-link" href="compliance">
                <i class="fa fa-shield-alt"></i>
                <span>Compliance Dashboard</span>
            </NavLink>
            <NavLink class="nav-link" href="drift">
                <i class="fa fa-exchange-alt"></i>
                <span>Drift Detection</span>
            </NavLink>
            <NavLink class="nav-link" href="health">
                <i class="fa fa-heartbeat"></i>
                <span>Health Status</span>
            </NavLink>
        </nav>
    </div>
    
    <div class="content-wrapper">
        <header class="top-header">
            <div class="d-flex align-items-center flex-grow-1">
                <h5 class="mb-0">@GetPageTitle()</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm" title="Refresh">
                    <i class="fa fa-refresh"></i>
                </button>
                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fa fa-user-circle me-1"></i> Admin
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="settings"><i class="fa fa-cog me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#"><i class="fa fa-sign-out-alt me-2"></i>Sign Out</a></li>
                    </ul>
                </div>
            </div>
        </header>
        
        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager? Navigation { get; set; }
    
    [Inject]
    private AppSettingsService? SettingsService { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        // Ensure settings are loaded and theme is applied
        if (SettingsService != null)
        {
            await SettingsService.InitializeAsync();
        }
    }
    
    private string GetPageTitle()
    {
        var path = Navigation?.ToBaseRelativePath(Navigation.Uri) ?? "";
        return path switch
        {
            "" => "Dashboard",
            "templates" => "Template Catalog",
            "templates/create" => "Create Template",
            "environments" => "Environments",
            "environments/create" => "Provision Environment",
            "environments/expiring" => "Expiring Environments",
            "drift" => "Drift Detection",
            "health" => "Health Status",
            _ when path.StartsWith("templates/") => "Template Details",
            _ when path.StartsWith("environments/") => "Environment Details",
            _ => "Platform Engineering Admin"
        };
    }
}
