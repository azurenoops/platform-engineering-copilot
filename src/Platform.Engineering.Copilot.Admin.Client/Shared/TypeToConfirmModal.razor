@* TypeToConfirmModal.razor — Type-to-confirm for bulk destructive actions *@

@if (IsVisible)
{
    <div class="confirm-modal-backdrop" @onclick="Cancel">
        <div class="confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" @onclick="Cancel" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>@Message</p>
                <p class="text-muted small">Type <strong>@ConfirmPhrase</strong> to confirm:</p>
                <input type="text" class="form-control" @bind="TypedText" @bind:event="oninput"
                       placeholder="@ConfirmPhrase" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-danger" @onclick="Confirm"
                        disabled="@(!IsMatch || IsProcessing)">
                    @if (IsProcessing)
                    {
                        <LoadingSpinner Inline="true" />
                    }
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "This action cannot be undone.";
    [Parameter] public string ConfirmPhrase { get; set; } = "CONFIRM";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string TypedText { get; set; } = string.Empty;
    private bool IsMatch => string.Equals(TypedText, ConfirmPhrase, StringComparison.OrdinalIgnoreCase);

    private async Task Confirm()
    {
        if (IsMatch && OnConfirm.HasDelegate)
            await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        TypedText = string.Empty;
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }
}
